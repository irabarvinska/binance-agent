# ============================================================
# BINANCE API КЛЮЧІ
# Отримати на: https://www.binance.com/en/my/settings/api-management
# ============================================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Увімкнути testnet для тестування (true/false)
BINANCE_TESTNET=true

# ============================================================
# TELEGRAM БОТ
# Отримати токен у @BotFather, chat_id через @userinfobot
# ============================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================
# NEWS API
# Отримати безкоштовно на: https://newsapi.org
# ============================================================
NEWS_API_KEY=your_news_api_key_here

# ============================================================
# НАЛАШТУВАННЯ АГЕНТА
# ============================================================
# Мінімальна сума угоди в USDT
MIN_TRADE_AMOUNT=10.0

# Максимальна сума однієї угоди в USDT
MAX_TRADE_AMOUNT=50.0

# Часовий пояс для звітів
TIMEZONE=Europe/Kyiv

# Рівень логування (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
